    {
      "title": "Tesla | Mechanical Design Engineer Intern",
      "dropdowns": [
        {
          "title": "TL;DR",
          "icon": "fa-solid fa-info-circle",
          "iconColor": "#000000",
          "items": [
            {
              "text": "<div class='text-container'><ul><li>Led design and development of seven thermal coolant components for CyberCab and other vehicles.</li><li>Managed RFQs, DFM reviews, and approved $160,000 in tooling for $1M+ annual components.</li><li>Optimized thermal designs using first-principles engineering, saving $100,000+ annually.</li><li>Directed investigations on automation, NVH, and insulation, performing eight tests and analyzing data.</li></ul></div>"
            }
          ]
        },
