            { "name": "Prototyping", "color": "#8B0000" },
            { "name": "Testing & Troubleshooting", "color": "#8B0000" },
            { "name": "2D Drawings (GD&T)", "color": "#8B0000" },
            { "name": "Request for Quote (RFQ) Process", "color": "#006400" },
            { "name": "Cost Optimization", "color": "#006400" },
            { "name": "Cross-functional Collaboration", "color": "#006400" },
